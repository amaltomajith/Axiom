# Copy to backend/.env.data (gitignored). Read only by the data platform (python -m data_platform ...),
# which deliberately ignores backend/.env so it can never write to the app's database.

# Source for `--env prod`: the app's Postgres through a READ-ONLY role (see docs/gcp-governance.md).
# Use the pooled Neon host and keep sslmode=require.
AXIOM_SOURCE_DATABASE_URL=postgresql://axiom_reader:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Optional: default BigQuery project and a service account to impersonate (instead of --project / --impersonate).
# AXIOM_GCP_PROJECT=
# AXIOM_IMPERSONATE=axiom-elt-loader@<project>.iam.gserviceaccount.com
