# Copy to backend/.env. Everything is optional: with no keys Axiom still runs using yfinance, Google News RSS,
# SEC EDGAR and a local Ollama model. Never commit the real file.

# ---- LLMs (all free tiers or local). The chain is tried in order; providers without a key are skipped.
LLM_CHAIN=groq,gemini,openrouter,ollama
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Nebius Token Factory: paid credits, OpenAI-compatible. Put `nebius` first in LLM_CHAIN to use it.
NEBIUS_API_KEY=
# Model ids change often: override when a provider renames one.
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
OLLAMA_MODEL=qwen3:8b
# Reasoning models burn tokens thinking; "none" turns that off on Ollama ("" keeps the model default).
OLLAMA_REASONING_EFFORT=none
RUN_TOKEN_BUDGET=60000
RUN_MAX_LLM_CALLS=24

# ---- Market data (optional keys; yfinance and SEC EDGAR work without any)
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
# SEC requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT=Axiom Research you@example.com

# ---- Security. REQUIRED before enabling real actions or exposing the API beyond localhost.
AXIOM_API_TOKEN=
ANALYZE_PER_HOUR=12
CORS_ORIGINS=http://localhost:5173,http://localhost:4200

# ---- Deployment (see docs/deployment.md). All optional locally; the deploy checklist lists what to set.
# Postgres for runs, theses, approvals and the shared response cache. Unset = local SQLite file.
# On serverless hosts use the pooled connection string (Neon: the host containing "-pooler").
DATABASE_URL=
# Global cap on analyses per UTC day across all visitors (0 = unlimited). Free LLM quotas are shared.
ANALYZE_PER_DAY=0
# Stop a run cleanly after N seconds (0 = off). On Vercel Hobby set it below the 300s function limit.
RUN_DEADLINE_SECONDS=0
# Take the client IP from X-Forwarded-For. Only behind a proxy you trust (defaults on for Vercel).
TRUST_PROXY=false
# Enables /api/cron/daily. Vercel Cron sends it automatically as "Authorization: Bearer <secret>".
CRON_SECRET=

# ---- Actions via Composio. Without COMPOSIO_API_KEY every action is a dry run (nothing is sent anywhere).
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=axiom-default
NOTION_PARENT_PAGE_ID=
SHEETS_SPREADSHEET_ID=
SLACK_CHANNEL=
ACTION_MIN_CONVICTION=0.5
# Run `uv run python -m axiom.actions.composio_check` after connecting accounts to verify tool slugs.

# ---- Daily briefing (runs inside the API process)
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 8 * * 1-5

# ---- Autopilot paper trader (see README "Autopilot"). Paper only: no setting enables real money.
# Alpaca PAPER keys (https://app.alpaca.markets, Paper account, API keys). Crypto bars work without keys;
# equities intraday, news and TRADER_BROKER=alpaca need them.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Start the live loop with the API process (never on serverless). Or POST /api/trader/start, or
# `uv run python -m axiom.trading run`.
TRADER_ENABLED=false
# sim = simulated broker in memory; alpaca = your Alpaca paper account
TRADER_BROKER=sim
# rule = tournament pick only; llm = the free LLM chain may pick among qualified strategies or veto
TRADER_BRAIN=rule
TRADER_SYMBOLS=BTC/USD,ETH/USD,SPY,QQQ,AAPL,NVDA,MSFT
TRADER_TIMEFRAME=1Hour
TRADER_INTERVAL_SECONDS=60
TRADER_STARTING_CASH=100000
# SHADOW (trades nothing) | SUPERVISED (a human approves each entry) | AUTONOMOUS
TRADER_AUTONOMY_START=SUPERVISED
# Hard limits enforced by the risk kernel
TRADER_DAILY_LOSS_LIMIT_PCT=0.02
TRADER_RISK_PER_TRADE=0.01
TRADER_MAX_POSITION_PCT=0.20
TRADER_MAX_OPEN_POSITIONS=4
TRADER_MAX_TRADES_PER_DAY=10
TRADER_MAX_LLM_CALLS_PER_HOUR=20

# ---- One-port demo: serve the built frontend (npm run build:selfhost) from this API on port 8000.
SERVE_FRONTEND=false
