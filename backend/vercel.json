{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,evals/**,scripts/**,.venv/**,.cache/**,**/__pycache__/**}"
    }
  },
  "crons": [{ "path": "/api/cron/daily", "schedule": "0 13 * * 1-5" }]
}
